generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

enum OrchestratorActionType {
  IMPORT
  SKIP
  TEST_CAMPAIGN
}

enum CampaignTestStatus {
  PENDING
  RUNNING
  COMPLETED
}

model ProductSnapshot {
  id            String         @id @default(uuid())
  externalId    String         @unique
  productName   String
  source        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  trendSignals  TrendSignal[]
  campaignTests CampaignTest[]
}

model TrendSignal {
  id                String                 @id @default(uuid())
  source            String
  keyword           String
  trendVelocity     Float
  engagementRate    Float?
  competitionLevel  Float?
  productSnapshotId String
  productSnapshot   ProductSnapshot        @relation(fields: [productSnapshotId], references: [id])
  winningScore      WinningScore?
  decisions         OrchestratorDecision[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([createdAt])
  @@unique([source, keyword, productSnapshotId])
}

model WinningScore {
  id                   String      @id @default(uuid())
  trendSignalId        String      @unique
  trendSignal          TrendSignal @relation(fields: [trendSignalId], references: [id])
  trendVelocity        Float
  engagementRate       Float
  adFrequency          Float
  marginPotential      Float
  supplierScore        Float
  lowCompetitionFactor Float
  sentimentScore       Float
  score                Float
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([score])
}

model OrchestratorDecision {
  id              String                 @id @default(uuid())
  trendSignalId   String
  trendSignal     TrendSignal            @relation(fields: [trendSignalId], references: [id])
  actionType      OrchestratorActionType
  confidenceScore Float
  reason          String
  createdAt       DateTime               @default(now())

  @@index([trendSignalId, createdAt])
}

model CampaignTest {
  id           String             @id @default(uuid())
  productId    String
  product      ProductSnapshot    @relation(fields: [productId], references: [id])
  budget       Float
  variantCount Int
  predictedCPA Float
  status       CampaignTestStatus @default(PENDING)
  createdAt    DateTime           @default(now())
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  context   String
  createdAt DateTime @default(now())
}


model QueueJobState {
  id             String   @id @default(uuid())
  queueName      String
  idempotencyKey String   @unique
  correlationId  String
  traceId        String
  tenantId       String
  status         String
  retryCount     Int      @default(0)
  failureCount   Int      @default(0)
  lastError      String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([queueName, status])
}

model SystemEvent {
  id                  String   @id @default(uuid())
  type                String
  actionType          String?
  correlationId       String
  executionDurationMs Int
  failure             Boolean  @default(false)
  payload             Json
  createdAt           DateTime @default(now())
}

model CompetitorStore {
  id               String   @id @default(cuid())
  domain           String   @unique
  platform         String   @default("shopify")
  estimatedTraffic Int?
  trustpilotScore  Float?
  createdAt        DateTime @default(now())
  priceHistory     PriceHistory[]
}

model ViralProduct {
  id              String   @id @default(cuid())
  productName     String
  tiktokViews24h  Int
  hashtag         String?
  viralScore      Float
  sentimentScore  Float?
  firstDetectedAt DateTime @default(now())
}

model PriceHistory {
  id                String          @id @default(cuid())
  competitorStore   CompetitorStore @relation(fields: [competitorStoreId], references: [id])
  competitorStoreId String
  productName       String
  oldPrice          Float
  newPrice          Float
  capturedAt        DateTime        @default(now())
}

model EngagementMetric {
  id             String   @id @default(cuid())
  productRef     String
  likes          Int
  comments       Int
  shares         Int
  conversionRate Float?
  capturedAt     DateTime @default(now())
}

model AdCreative {
  id         String   @id @default(cuid())
  platform   String
  productRef String
  hook       String
  script     String
  ctr        Float?
  createdAt  DateTime @default(now())
}

model CampaignSimulation {
  id             String   @id @default(cuid())
  productRef     String
  expectedCpa    Float
  expectedRoas   Float
  expectedMargin Float
  budget         Float
  simulatedAt    DateTime @default(now())
}

model ScrapingJob {
  id        String   @id @default(cuid())
  jobType   String
  status    String   @default("pending")
  payload   Json
  retries   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProxyPool {
  id            String   @id @default(cuid())
  proxyUrl      String   @unique
  healthScore   Float    @default(100)
  requestCount  Int      @default(0)
  isActive      Boolean  @default(true)
  lastCheckedAt DateTime?
}

model MarketSaturationMetric {
  id                    String   @id @default(cuid())
  productRef            String
  activeAdsCount        Int
  competitorStoresCount Int
  priceCompression      Float
  saturationIndex       Float
  createdAt             DateTime @default(now())
}

model CreativeFatigueMetric {
  id                 String   @id @default(cuid())
  adCreativeId       String
  engagementDrop     Float
  repetitionRate     Float
  sentimentDowntrend Float
  fatigueIndex       Float
  createdAt          DateTime @default(now())
}

model SupplierRiskMetric {
  id                String   @id @default(cuid())
  supplierRef       String
  deliveryDelayRate Float
  disputeRate       Float
  reviewPenalty     Float
  stockVolatility   Float
  riskIndex         Float
  createdAt         DateTime @default(now())
}

model ABTestExperiment {
  id            String   @id @default(cuid())
  productRef    String
  budgetPerHook Float
  hooksJson     Json
  winnerHook    String?
  status        String   @default("running")
  createdAt     DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  image    String?
  products Product[]
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Float
  salePrice   Float?
  images      String[]
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  brand       String?
  rating      Float       @default(0)
  reviewCount Int         @default(0)
  stock       Int         @default(0)
  sku         String?     @unique
  tags        String[]
  featured    Boolean     @default(false)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  reviews     Review[]
  orderItems  OrderItem[]
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  title     String?
  body      String?
  author    String
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id         String      @id @default(uuid())
  customerId String
  status     OrderStatus @default(PENDING)
  total      Float
  address    String
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([customerId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}
