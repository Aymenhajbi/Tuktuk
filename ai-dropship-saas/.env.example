# ── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# On Railway: auto-provided by the Postgres plugin — copy from the "Connect" tab
POSTGRES_DB=dropship
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ── Redis ─────────────────────────────────────────────────────────────────────
# On Railway: auto-provided by the Redis plugin
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_URL=redis://:PASSWORD@HOST:6379
REDIS_TLS=false

# ── Queue Workers ─────────────────────────────────────────────────────────────
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_DELAY_MS=1000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use LIVE keys in production (sk_live_... / pk_live_...)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── CJ Dropshipping ───────────────────────────────────────────────────────────
# Get from: https://developers.cjdropshipping.com
CJ_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=https://tuktuk-storefront.up.railway.app,https://tuktuk-admin.up.railway.app

# ── Frontend URLs ─────────────────────────────────────────────────────────────
# Public URL browsers use to reach the backend (set in admin + storefront services)
NEXT_PUBLIC_API_URL=https://tuktuk-backend.up.railway.app

# ── External Scrapers (optional) ──────────────────────────────────────────────
TIKTOK_SCRAPER_API_KEY=
SIMILARWEB_API_KEY=
PROXY_LIST=

# ── Elasticsearch / Vector DB (optional) ─────────────────────────────────────
ELASTICSEARCH_URL=
VECTOR_DB_PROVIDER=weaviate
WEAVIATE_URL=
PINECONE_API_KEY=
